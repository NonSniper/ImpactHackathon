# SQLite is the default; paths are relative to the backend directory.
DATABASE_URL=sqlite:///./app.db
# Comma-separated browser origins, without trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a long random secret outside version control to enable admin endpoints.
ADMIN_API_TOKEN=
# Optional S3-compatible persistent product image storage (e.g. Cloudflare R2).
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_BASE_URL=
